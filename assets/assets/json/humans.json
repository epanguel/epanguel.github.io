  "パーソンズ（Parsons, F.）": {
    "level": "3",
    "fullname": "フランク・パーソンズ（Frank Parsons）",
    "gender": "男性",
    "desc": [
      "職業指導[運動]の祖として知られる。",
      "土木技師、製鉄所、公立高校教師、法律家、出版編集者、大学教員など多くの経歴を持つ。",
      "1905年にボストン市に設立された労働者のための学校「ブレットウィナーズ・インスティテュート」に校長として招聘される。",
      "校長として従事する中で、そこを訪れる労働者が平均6回も転職を繰り返している現実に気づき、同施設内に職業局を置き、友人とともに職業カウンセラーとなる。",
      "また、並行してボストンYMCAで職業カウンセラーの養成事業にも乗り出した。"
    ],
    "memo": "",
    "keywords": [
      "職業指導[運動]",
      "職業の選択",
      "丸い釘は丸い穴に",
      "特性因子理論"
    ]
